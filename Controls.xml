<GuiXml>
    <!--
        The controls this add-on draws on the skill bar.

        Laid out here rather than in Lua on purpose: a row of controls assembled with SetAnchor
        from an add-on ran into anchor limits and zero-height rows on the console gamepad UI once
        already (PB's MailerExtension). These are plain textures and labels of our own, with no
        client template inherited, and only the parent is chosen at runtime, because the controls
        they hang on (ActionButton3..8) do not exist until the UI has loaded.

        PBsConsoleHudCustomizerBackBarSlot is one slot of the back bar: the other weapon set's
        ability, drawn in the game's own back row frame (52 x 68, icon 44 x 44, the sizes and
        texture coordinates of ZO_ActionBarTimer_BackBarSlot_Gamepad).

        PBsConsoleHudCustomizerSlotLabels is the countdown and target count for a slot of the
        game's own bar: nothing but two labels, filling the button it is parented to.

        Both fonts are replaced from Lua at the size the player chose. The ones here are only so
        that a control is legible if that ever fails.
    -->
    <Controls>
        <!--
            The countdown, in the client's own shape: ZoFontGamepad27 at DCD822, 25 high, width 0
            so it sizes itself to the text, centred. ActionButton<n>TimerText is the same, and
            this one takes its place on the icon, so a number does not jump when the game's own
            action bar timers are switched on or off.
        -->
        <Label name="PBsConsoleHudCustomizerTimerLabel" font="ZoFontGamepad27" color="DCD822"
               horizontalAlignment="CENTER" verticalAlignment="CENTER" virtual="true">
            <Dimensions x="0" y="25"/>
        </Label>
        <Label name="PBsConsoleHudCustomizerCountLabel" font="ZoFontGamepad27" color="FFFFFF"
               horizontalAlignment="CENTER" verticalAlignment="TOP" virtual="true">
            <Dimensions x="0" y="25"/>
        </Label>

        <Control name="PBsConsoleHudCustomizerBackBarSlot" virtual="true" tier="MEDIUM">
            <Dimensions x="52" y="68"/>
            <Controls>
                <Texture name="$(parent)BG" textureFile="EsoUI/Art/ActionBar/Gamepad/gp_backrow_abilityFrame_BLANK.dds" level="0">
                    <Dimensions x="52" y="68"/>
                    <Anchor point="CENTER"/>
                    <TextureCoords left="0" right="0.8125" top="0" bottom="1.0625"/>
                </Texture>
                <Texture name="$(parent)Icon" level="1">
                    <Dimensions x="44" y="44"/>
                    <Anchor point="CENTER"/>
                </Texture>
                <Texture name="$(parent)Overlay" textureFile="EsoUI/Art/ActionBar/Gamepad/gp_backrow_abilityFrame_overlay.dds" level="2">
                    <Dimensions x="52" y="68"/>
                    <Anchor point="CENTER"/>
                    <TextureCoords left="0" right="0.8125" top="0" bottom="1.0625"/>
                </Texture>
                <Cooldown name="$(parent)Shade" inherits="PBsConsoleHudCustomizerShade" level="2">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Icon" relativePoint="BOTTOMRIGHT"/>
                </Cooldown>
                <Label name="$(parent)Timer" inherits="PBsConsoleHudCustomizerTimerLabel" level="3">
                    <Anchor point="CENTER" relativeTo="$(parent)Icon" relativePoint="CENTER" offsetY="2"/>
                </Label>
                <Label name="$(parent)Count" inherits="PBsConsoleHudCustomizerCountLabel" level="3">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="TOPLEFT" offsetX="-2" offsetY="-4"/>
                </Label>
            </Controls>
        </Control>

        <Control name="PBsConsoleHudCustomizerSlotLabels" virtual="true" tier="HIGH">
            <Controls>
                <Label name="$(parent)Timer" inherits="PBsConsoleHudCustomizerTimerLabel">
                    <Anchor point="CENTER" relativePoint="CENTER" offsetY="4"/>
                </Label>
                <!--
                    Top left, because the client's own stack count sits at CENTER +23, -20, which
                    is the top right of the icon. Two different numbers in one corner would be
                    unreadable.
                -->
                <Label name="$(parent)Count" inherits="PBsConsoleHudCustomizerCountLabel">
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" offsetX="-2" offsetY="-4"/>
                </Label>
            </Controls>
        </Control>

        <!--
            The shade over a skill icon while its effect runs. A Cooldown control, the same kind
            the client uses for ability cooldowns: given the ability's own icon and started with
            CD_TYPE_VERTICAL_REVEAL, the engine darkens the icon and wipes that darkness away
            down the icon as the time runs out, on its own, with no work per frame from here.
        -->
        <Cooldown name="PBsConsoleHudCustomizerShade" virtual="true"
                  leadingEdgeTexture="EsoUI/Art/ActionBar/coolDown_leadingEdge.dds"
                  fillColor="000000" alpha="0.6" hidden="true" level="5">
            <AnchorFill/>
        </Cooldown>

        <!--
            The liquid look for one attribute bar, drawn over the client's own fill: a darker
            bottom for depth, two bands of light drifting across at different speeds, and a bright
            line at the surface where the fill ends.

            Every texture here is one the bar has already loaded for itself
            (attributeBar_dynamic_fill_gloss and its leading edge) or one the generic progress
            bars use, so the look costs the console's shared pool nothing at all. The bands are
            positioned and clipped from Lua, because ESO does not clip a child to its parent: a band
            is given the width it should show, and the texture coordinates to match.
        -->
        <Control name="PBsConsoleHudCustomizerLiquid" virtual="true" level="600">
            <Controls>
                <Texture name="$(parent)Depth" level="1" color="000000" alpha="0.45"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_fill_gloss.dds">
                    <AnchorFill/>
                    <TextureCoords left="0" right="1" top="0.53125" bottom="0"/>
                </Texture>
                <Texture name="$(parent)Band1" level="2" alpha="0.45" blendMode="ADD"
                         textureFile="EsoUI/Art/Miscellaneous/progressbar_genericFill_gloss.dds">
                    <Dimensions x="70"/>
                </Texture>
                <Texture name="$(parent)Band2" level="2" alpha="0.3" blendMode="ADD"
                         textureFile="EsoUI/Art/Miscellaneous/progressbar_genericFill_gloss.dds">
                    <Dimensions x="120"/>
                </Texture>
                <Texture name="$(parent)Surface" level="3" alpha="1" blendMode="ADD"
                         textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_leadingEdge_gloss.dds">
                    <Dimensions x="14"/>
                    <TextureCoords left="0" right="0.6875" top="0" bottom="0.53125"/>
                </Texture>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
